# Deny by default. Only source, model license and dependencies may enter a build.
**
!pyproject.toml
!uv.lock
!licenses/
!licenses/model-APACHE-2.0.txt
!requirements*.txt
!src/
!src/**

# Keep defensive exclusions even if a credential is misplaced inside src/.
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/.private/**
**/__pycache__/**
